[Unit]
Description=Course notes server (Arduino UNO Q)
# The LED matrix firmware is reached through arduino-router's socket.
Wants=network-online.target arduino-router.service
After=network-online.target arduino-router.service

[Service]
Type=simple
User=notes
Group=notes
EnvironmentFile=/etc/notes-server/env
WorkingDirectory=/var/lib/notes-server
ExecStart=/opt/notes-server/notes-server
Restart=on-failure
RestartSec=3
# SIGTERM -> graceful shutdown drains requests for up to 30 s.
TimeoutStopSec=40

# Bind 443/80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening: read-only system, writable data dir, no devices. (Connecting to the
# router's Unix socket still works on the read-only /run.)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/notes-server
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

# 4 GB board; normal peak with IMAGE_WORKERS=2 is far below this.
MemoryMax=1500M
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
