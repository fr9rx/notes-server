# /etc/notes-server/env — read by systemd (EnvironmentFile). Keep it mode 600.

# Required, >= 32 chars. setup-pi.sh generates one.
ADMIN_TOKEN=change-me

# The address users type in the browser; used to build image URLs and the HTTP redirect.
PUBLIC_BASE_URL=https://notes.example.com

BIND_ADDR=0.0.0.0:443
HTTP_REDIRECT_ADDR=0.0.0.0:80
TLS_CERT_PATH=/etc/notes-server/certs/cert.pem
TLS_KEY_PATH=/etc/notes-server/certs/key.pem
# certbot --webroot -w this dir; served on the port-80 listener.
ACME_WEBROOT=/var/lib/notes-server/acme

DATABASE_URL=sqlite:///var/lib/notes-server/notes.db
UPLOAD_DIR=/var/lib/notes-server/uploads

# The website's origin, if it is served from a different domain than this API.
#CORS_ORIGIN=https://www.example.com

# Parallel image jobs (Pi 5 has 4 cores; 2 leaves headroom for serving).
IMAGE_WORKERS=2
# Refuse uploads when less than this much disk would remain.
MIN_FREE_DISK_MB=1024
# Per-IP public upload limit: burst size, and seconds to regain one slot.
UPLOAD_BURST=5
UPLOAD_REFILL_SECS=12

RUST_LOG=notes_server=info,tower_http=info
